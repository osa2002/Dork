rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isShopOwner(shopId) {
      return shopId.matches('^demo_user_.*') || (request.auth != null && request.auth.uid == shopId);
    }

    // 2. Shops Collection
    match /shops/{shopId} {
      allow read: if true; // Anyone (customer or vendor) can read a shop
      allow create: if shopId.matches('^demo_user_.*') || isSignedIn();
      allow update: if isShopOwner(shopId) || 
                       exists(/databases/$(database)/documents/shops/$(shopId)/private/verification) ||
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastTicketNumber', 'date']);
      allow delete: if isShopOwner(shopId);

      match /private/verification {
        allow read: if false; // Completely private, no one can read
        allow create, update: if request.resource.data.serverSecret == "DORK_SERVER_SECRET_987654321_PRO_TOKEN";
        allow delete: if isShopOwner(shopId) || true; // Safe cleanup of temporary tokens
      }

      match /invoices/{invoiceId} {
        allow read: if isShopOwner(shopId);
        allow write: if isShopOwner(shopId) || exists(/databases/$(database)/documents/shops/$(shopId)/private/verification);
      }
    }

    // 3. Services Collection
    match /services/{serviceId} {
      allow read: if true; // Anyone can read services
      allow create: if request.resource.data.shopId.matches('^demo_user_.*') || (isSignedIn() && request.auth.uid == request.resource.data.shopId);
      allow update, delete: if isShopOwner(resource.data.shopId);
    }

    // 4. Tickets Collection
    match /tickets/{ticketId} {
      allow read: if true; // Anyone can read/subscribe to tickets for a shop
      allow create: if true; // Customers and demo vendors can create tickets
      allow update: if isShopOwner(resource.data.shopId) || (
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
                       request.resource.data.status == 'cancelled' &&
                       resource.data.status == 'waiting'
                     );
      allow delete: if isShopOwner(resource.data.shopId) || exists(/databases/$(database)/documents/shops/server_cleanup/private/verification);
    }

    // 5. Displays Collection
    match /displays/{displayId} {
      allow read: if true; // Public screens can read, shop owners can read all displays
      allow create: if true; // Public screens can register
      allow update: if isShopOwner(resource.data.shopId) || (
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastActive'])
                     );
      allow delete: if isShopOwner(resource.data.shopId);
    }

    // 6. Archived Tickets Collection
    match /archived_tickets/{ticketId} {
      allow read: if false;
      allow write: if exists(/databases/$(database)/documents/shops/server_cleanup/private/verification);
    }

    // 7. Booking Errors Collection
    match /booking_errors/{errorId} {
      allow create: if true; // Anyone (customer sessions) can record booking errors
      allow read, delete: if isShopOwner(resource.data.shopId); // Only the shop owner can read/manage logs
    }

    // 8. Ticket Counters Collection
    match /ticket_counters/{counterId} {
      allow read: if true;
      allow write: if false; // Managed exclusively via server transactions
    }

    // 9. Counter Statuses Collection
    match /counter_statuses/{statusId} {
      allow read: if true; // Anyone can view window statuses
      allow write: if (isSignedIn() && (statusId.startsWith(request.auth.uid + "_") || statusId.startsWith("demo_user_"))) ||
                      (request.resource.data.shopId != null && isShopOwner(request.resource.data.shopId));
    }

    // 10. Webhooks Collection
    match /webhooks/{webhookId} {
      allow read: if isShopOwner(resource.data.shopId);
      allow create: if isShopOwner(request.resource.data.shopId);
      allow update, delete: if isShopOwner(resource.data.shopId);
    }

    // 11. Webhook Logs Collection
    match /webhook_logs/{logId} {
      allow read: if isShopOwner(resource.data.shopId);
      allow create: if isShopOwner(request.resource.data.shopId);
      allow update, delete: if isShopOwner(resource.data.shopId);
    }
  }
}
